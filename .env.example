APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Survei SKM internal sudah dimatikan — semua pengisian diarahkan ke sini.
SKM_EXTERNAL_URL=https://gandem.id/page/survey/skm/

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Google OAuth
GOOGLE_CLIENT_ID=964873252068-dd0pqvcqn4drqlifl8emiq2cnmkic2gi.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT=http://localhost/auth/google/callback

# Integrasi webhook Layanan Madrasah
# Harus SAMA PERSIS dengan PTSP_WEBHOOK_SECRET di aplikasi Layanan Madrasah.
LAYANAN_MADRASAH_WEBHOOK_SECRET=ganti-dengan-string-acak-panjang-dan-rahasia
LAYANAN_MADRASAH_DEFAULT_LAYANAN_ID=26
# Mapping tipe_layanan -> id tabel `layanan` PTSP. Nilai di bawah ini sudah
# jadi default di config/services.php, jadi baris-baris ini OPSIONAL --
# isi ulang hanya kalau ID di production ternyata berbeda.
# LAYANAN_MADRASAH_LAYANAN_ID_REKOMENDASI=62
# LAYANAN_MADRASAH_LAYANAN_ID_REKOMENDASI_KAMAD=61
# LAYANAN_MADRASAH_LAYANAN_ID_PINDAH_SEKOLAH=26
# LAYANAN_MADRASAH_LAYANAN_ID_INPUT_SISWA=67
# LAYANAN_MADRASAH_LAYANAN_ID_REAKTIVASI=67
# LAYANAN_MADRASAH_LAYANAN_ID_RESET_VERVAL=69
# LAYANAN_MADRASAH_LAYANAN_ID_SALAH_TINGKAT=67
# LAYANAN_MADRASAH_LAYANAN_ID_PERUBAHAN_IJOP=57
# Opsional, kosongkan untuk menonaktifkan (lihat config/services.php)
LAYANAN_MADRASAH_WEBHOOK_IP_ALLOWLIST=
