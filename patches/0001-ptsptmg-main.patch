@@ -0,0 +1,55 @@
+<?php
+
+namespace App\Http\Middleware;
+
+use Closure;
+use Illuminate\Http\Request;
+use Symfony\Component\HttpFoundation\Response;
+
+/**
+ * OPSIONAL / BELUM DIPAKAI PADA VERSI INI.
+ *
+ * Disiapkan untuk skenario dua-arah penuh: jika suatu saat PTSP Online perlu
+ * mengirim webhook BALIK ke Layanan Madrasah (mis. update status manual dari
+ * sisi PTSP tanpa melalui respons sinkron job), middleware ini bisa dipasang
+ * pada route baru di prefix /webhook milik aplikasi ini.
+ *
+ * Pada alur yang diminta di task ini (Fase 1 & 2), PTSP Online cukup
+ * membalas secara SINKRON lewat body response HTTP saat dipanggil oleh
+ * Job (RequestTiketPtspJob / UploadRekomPtspJob), sehingga middleware ini
+ * belum digunakan di routes/web.php. Lihat HANDOFF_NOTES.md.
+ */
+class VerifyPtspWebhookSecret
+{
+    public function handle(Request $request, Closure $next): Response
+    {
+        $expected = (string) config('services.ptsp.webhook_secret');
+        $given    = (string) $request->header('X-Webhook-Secret', '');
+
+        if (empty($expected) || !hash_equals($expected, $given)) {
+            return response()->json([
+                'success' => false,
+                'message' => 'Token webhook tidak valid.',
+            ], 401);
+        }
+
+        // Lapisan kedua (opsional selama masa transisi): lihat komentar
+        // setara di VerifyLayananMadrasahWebhookSecret milik PTSP Online
+        // untuk penjelasan lengkap. Header: X-Webhook-Signature =
+        // hash_hmac('sha256', $rawBody, $secret).
+        $signatureGiven = (string) $request->header('X-Webhook-Signature', '');
+
+        if (!empty($signatureGiven)) {
+            $signatureExpected = hash_hmac('sha256', (string) $request->getContent(), $expected);
+
+            if (!hash_equals($signatureExpected, $signatureGiven)) {
+                return response()->json([
+                    'success' => false,
+                    'message' => 'Signature webhook tidak valid.',
+                ], 401);
+            }
+        }
+
+        return $next($request);
+    }
+}
