+<?php
+
+namespace App\Http\Controllers;
+
+use App\Jobs\RequestTiketPtspJob;
+use App\Jobs\UploadRekomPtspJob;
+use App\Models\LayananRekomendasi;
+use App\Support\LayananWorkflow;
+use Illuminate\Http\RedirectResponse;
+use Illuminate\Support\Facades\Log;
+
+class PtspIntegrationController extends Controller
+{
+    /**
+     * FASE 1 — Tombol "Ticket".
+     * Hanya admin_ptsp (atau super_admin) yang boleh memicu, dan hanya
+     * jika berkas (surat_path) sudah tersedia serta belum punya no_tiket.
+     */
+    public function requestTiket(LayananRekomendasi $data): RedirectResponse
+    {
+        $actor = auth('admin')->user() ?? auth()->user();
+
+        if (!$actor || !($actor->isAdminPtsp() || $actor->isSuperAdmin())) {
+            abort(403, 'Hanya Admin PTSP yang dapat meminta tiket.');
+        }
+
+        if (!empty($data->no_tiket)) {
+            return back()->with('warning', 'Pengajuan ini sudah memiliki nomor tiket PTSP.');
+        }
+
+        if (empty($data->surat_path)) {
+            return back()->with('error', 'Berkas surat belum tersedia, tidak bisa membuat tiket.');
+        }
+
+        try {
+            $data->forceFill(['status_ptsp' => 'dikirim', 'ptsp_last_error' => null])->save();
+
+            RequestTiketPtspJob::dispatch($data->id);
+
+            Log::info('[PTSP] RequestTiketPtspJob di-dispatch oleh ' . $actor->email ?? $actor->id, ['id' => $data->id]);
+        } catch (\Throwable $e) {
+            Log::error('[PTSP] Gagal dispatch RequestTiketPtspJob.', ['id' => $data->id, 'error' => $e->getMessage()]);
+            return back()->with('error', 'Gagal memproses permintaan tiket. Silakan coba lagi.');
+        }
+
+        return back()->with('success', 'Permintaan tiket sedang diproses di latar belakang. Halaman ini akan menampilkan nomor tiket setelah selesai.');
+    }
+
+    /**
+     * FASE 2 — Tombol "Unggah Rekom".
+     * Membutuhkan link_drive_rekom (link Google Drive hasil surat rekomendasi
+     * yang sudah diterbitkan oleh PTSP secara manual/offline, ATAU link yang
+     * sama dengan pdf_path bila surat digenerate otomatis oleh sistem ini).
+     */
+    public function unggahRekom(LayananRekomendasi $data): RedirectResponse
+    {
+        $actor = auth('admin')->user() ?? auth()->user();
+
+        if (!$actor || !($actor->isAdminPtsp() || $actor->isSuperAdmin())) {
+            abort(403, 'Hanya Admin PTSP yang dapat mengunggah rekomendasi.');
+        }
+
+        if (empty($data->no_tiket)) {
+            return back()->with('error', 'Data ini belum memiliki nomor tiket. Klik tombol "Ticket" terlebih dahulu.');
+        }
+
+        $link = request()->validate([
+            'link_drive_rekom' => ['required', 'url', 'max:2048'],
+        ])['link_drive_rekom'];
+
+        try {
+            UploadRekomPtspJob::dispatch($data->id, $link);
+
+            Log::info('[PTSP] UploadRekomPtspJob di-dispatch.', ['id' => $data->id, 'no_tiket' => $data->no_tiket]);
+        } catch (\Throwable $e) {
+            Log::error('[PTSP] Gagal dispatch UploadRekomPtspJob.', ['id' => $data->id, 'error' => $e->getMessage()]);
+            return back()->with('error', 'Gagal memproses unggah rekomendasi. Silakan coba lagi.');
+        }
+
+        return back()->with('success', 'Rekomendasi sedang diunggah ke PTSP Online di latar belakang.');
+    }
+}
