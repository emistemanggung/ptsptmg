+<?php
+require __DIR__ . '/../vendor/autoload.php';
+$app = require_once __DIR__ . '/../bootstrap/app.php';
+$kernel = $app->make(Illuminate\Contracts\Console\Kernel::class);
+$kernel->bootstrap();
+
+use App\Models\LayananRekomendasi;
+use App\Jobs\UploadRekomPtspJob;
+
+$id = $argv[1] ?? 2;
+$lr = LayananRekomendasi::find($id);
+if (! $lr) {
+    echo "LayananRekomendasi id=$id not found\n";
+    exit(1);
+}
+
+// provide a sample link if missing
+if (empty($lr->link_drive_rekom)) {
+    $lr->link_drive_rekom = 'https://drive.google.com/file/d/FAKE_UPLOAD_ID/view?usp=sharing';
+}
+
+$lr->status_ptsp = 'dikirim';
+$lr->ptsp_last_error = null;
+$lr->save();
+
+echo "Dispatching UploadRekomPtspJob for layanan_rekomendasi id={$id}\n";
+
+try {
+    UploadRekomPtspJob::dispatchSync($id, $lr->link_drive_rekom);
+    echo "Job dispatched\n";
+} catch (\Throwable $e) {
+    echo "Job failed: " . $e->getMessage() . "\n";
+    exit(1);
+}
+
+// show updated model
+$lr->refresh();
+echo json_encode($lr->toArray(), JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . "\n";
diff --git a/tests/Unit/PtspIntegrationJobsTest.php b/tests/Unit/PtspIntegrationJobsTest.php
new file mode 100644
index 0000000..9164f81
--- /dev/null
+++ b/tests/Unit/PtspIntegrationJobsTest.php
@@ -0,0 +1,147 @@
+<?php
+
+namespace Tests\Unit;
+
+use App\Jobs\RequestTiketPtspJob;
+use App\Jobs\UploadRekomPtspJob;
+use App\Models\LayananRekomendasi;
+use Illuminate\Support\Facades\Http;
+use Tests\TestCase;
+
+/**
+ * Ditambahkan sesi lanjutan (lihat webhook-integration/HANDOFF_NOTES.md
+ * poin 4g / 7e-2 / 8c-2). Belum pernah dijalankan (sandbox tidak punya
+ * `vendor/` — composer install tidak bisa akses packagist.org dari daftar
+ * domain yang diizinkan). JALANKAN `php artisan test --filter=PtspIntegrationJobsTest`
+ * di environment yang punya `composer install` sebelum dianggap lulus.
+ *
+ * Catatan penting: RequestTiketPtspJob/UploadRekomPtspJob menghitung
+ * X-Webhook-Signature dari `json_encode($payload)` dan mengirim body via
+ * `withBody()`, BUKAN lewat `Http::post($url, $payload)`. Assert di bawah
+ * membandingkan raw request body (bukan $request->data()) supaya benar-benar
+ * menguji kecocokan antara body yang di-hash dan body yang dikirim di wire.
+ */
+class PtspIntegrationJobsTest extends TestCase
+{
+    private function buatDataRekomendasi(array $overrides = []): LayananRekomendasi
+    {
+        return LayananRekomendasi::create(array_merge([
+            'nsm' => '123456789012',
+            'nama_madrasah' => 'MTs Contoh',
+            'no_surat' => 'SP/001/2026',
+            'tanggal_surat' => now()->toDateString(),
+            'hal_permohonan' => 'Permohonan Rekomendasi',
+            'tujuan' => 'Kabupaten Sidoarjo',
+            'kota_tujuan' => 'Sidoarjo',
+            'surat_path' => 'surat/contoh.pdf',
+            'status' => 'disetujui',
+        ], $overrides));
+    }
+
+    private function fakeConfig(): void
+    {
+        config([
+            'services.ptsp.base_url' => 'https://ptsp.test',
+            'services.ptsp.webhook_secret' => 'secret-ptsp-test',
+            'services.ptsp.timeout' => 15,
+        ]);
+    }
+
+    public function test_request_tiket_job_mengirim_signature_hmac_yang_valid_dan_menyimpan_no_tiket(): void
+    {
+        $this->fakeConfig();
+        $data = $this->buatDataRekomendasi();
+
+        Http::fake([
+            'https://ptsp.test/webhook/permohonan/tiket' => Http::response([
+                'success' => true,
+                'nomor_tiket' => 'TKT-ABCDEFGHIJKLM',
+            ], 201),
+        ]);
+
+        RequestTiketPtspJob::dispatchSync($data->id);
+
+        Http::assertSent(function ($request) {
+            $expectedSignature = hash_hmac('sha256', $request->body(), 'secret-ptsp-test');
+
+            return $request->url() === 'https://ptsp.test/webhook/permohonan/tiket'
+                && $request->hasHeader('X-Webhook-Secret', 'secret-ptsp-test')
+                && $request->header('X-Webhook-Signature')[0] === $expectedSignature;
+        });
+
+        $data->refresh();
+        $this->assertSame('TKT-ABCDEFGHIJKLM', $data->no_tiket);
+        $this->assertSame('Tiket PTSP Diterima', $data->status_ptsp);
+        $this->assertNull($data->ptsp_last_error);
+    }
+
+    public function test_request_tiket_job_skip_jika_sudah_punya_no_tiket(): void
+    {
+        $this->fakeConfig();
+        $data = $this->buatDataRekomendasi(['no_tiket' => 'TKT-SUDAH-ADA000']);
+
+        Http::fake();
+
+        RequestTiketPtspJob::dispatchSync($data->id);
+
+        Http::assertNothingSent();
+    }
+
+    public function test_request_tiket_job_menyimpan_error_dan_melempar_exception_saat_ptsp_gagal(): void
+    {
+        $this->fakeConfig();
+        $data = $this->buatDataRekomendasi();
+
+        Http::fake([
+            'https://ptsp.test/*' => Http::response(['success' => false], 500),
+        ]);
+
+        $this->expectException(\RuntimeException::class);
+
+        try {
+            RequestTiketPtspJob::dispatchSync($data->id);
+        } finally {
+            $data->refresh();
+            $this->assertNotEmpty($data->ptsp_last_error);
+            $this->assertEmpty($data->no_tiket);
+        }
+    }
+
+    public function test_upload_rekom_job_mengirim_signature_hmac_yang_valid_dan_update_status(): void
+    {
+        $this->fakeConfig();
+        $data = $this->buatDataRekomendasi(['no_tiket' => 'TKT-SUDAH-ADA000']);
+
+        Http::fake([
+            'https://ptsp.test/webhook/permohonan/rekomendasi' => Http::response(['success' => true], 200),
+        ]);
+
+        UploadRekomPtspJob::dispatchSync($data->id, 'https://drive.google.com/file/rekom-x');
+
+        Http::assertSent(function ($request) {
+            $expectedSignature = hash_hmac('sha256', $request->body(), 'secret-ptsp-test');
+
+            return $request->url() === 'https://ptsp.test/webhook/permohonan/rekomendasi'
+                && $request->header('X-Webhook-Signature')[0] === $expectedSignature;
+        });
+
+        $data->refresh();
+        $this->assertSame('https://drive.google.com/file/rekom-x', $data->link_drive_rekom);
+        $this->assertSame('Rekomendasi Terbit', $data->status_ptsp);
+    }
+
+    public function test_upload_rekom_job_tidak_memanggil_http_jika_belum_punya_no_tiket(): void
+    {
+        $this->fakeConfig();
+        $data = $this->buatDataRekomendasi(); // no_tiket masih kosong
+
+        Http::fake();
+
+        UploadRekomPtspJob::dispatchSync($data->id, 'https://drive.google.com/file/rekom-x');
+
+        Http::assertNothingSent();
+
+        $data->refresh();
+        $this->assertNotEmpty($data->ptsp_last_error);
+    }
+}
